	measure 'AUC Rata-rata' = DIVIDE ( SUMX ( 'Metrik Harian', 'Metrik Harian'[auc] * 'Metrik Harian'[n] ), SUMX ( FILTER ( 'Metrik Harian', NOT ISBLANK ( 'Metrik Harian'[auc] ) ), 'Metrik Harian'[n] ) )
		formatString: 0.000
		lineageTag: 3e822aa4-0d15-44ae-91ee-6dba91b6faed

	measure 'AUC 7 Hari' = CALCULATE ( [AUC Rata-rata], DATESINPERIOD ( Tanggal[Date], MAX ( Tanggal[Date] ), -7, DAY ) )
