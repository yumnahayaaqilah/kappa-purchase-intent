	column 'Segmen Skor' = SWITCH ( TRUE (), Sesi[persentil] <= 5, "1 Tinggi", Sesi[persentil] <= 20, "2 Sedang", "3 Rendah" )
		dataType: string
		lineageTag: af0f199f-97ca-447a-9d38-b1f591b211da
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Desil = ROUNDUP ( Sesi[persentil] / 10, 0 )
		dataType: int64
		formatString: 0
		lineageTag: 7f11abf0-f609-4f63-911f-335c83a8e749
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Kelompok Harga' = SWITCH ( TRUE (), Sesi[harga_max] < 10, "1 < 10", Sesi[harga_max] < 50, "2 10–50", Sesi[harga_max] < 200, "3 50–200", Sesi[harga_max] < 1000, "4 200–1.000", "5 ≥ 1.000" )
		dataType: string
		lineageTag: f70d1033-1b4e-416a-afd1-660856d1ce4e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Ada Keranjang' = IF ( Sesi[n_keranjang] > 0, "Ada keranjang", "Tanpa keranjang" )
		dataType: string
		lineageTag: 5e803c56-0aa1-42c2-8832-1d6c657626c4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Sesi = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5432", "ecommerce_db"),
				    public_pbi_sessions = Source{[Schema="public",Item="pbi_sessions"]}[Data]
				in
				    public_pbi_sessions

	annotation PBI_ResultType = Table

