table Sesi
	lineageTag: 89344599-e765-4838-bd63-f16c6428f3cb

	measure 'Total Sesi' = COUNTROWS ( Sesi )
		formatString: #,0
		lineageTag: 80204b61-a961-4835-a694-60789a5209c8

	measure 'Sesi Membeli' = SUM ( Sesi[beli] )
		formatString: #,0
		lineageTag: 3b417587-c0a5-45a2-b7e7-7844682ce1f0

	measure 'Tingkat Pembelian' = DIVIDE ( [Sesi Membeli], [Total Sesi] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2faf1294-1d8e-42c5-91d0-21bd22960868

	measure 'Rata-rata Skor' = AVERAGE ( Sesi[prob] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ac1c4b34-a36c-441d-8b3e-ed8da7221759

	measure 'Total Sesi (Label)' = FORMAT ( [Total Sesi], "#,0" )
		lineageTag: 955b4d37-3115-4840-88ef-63787d43e0c8

	measure 'Precision Top 5%' = DIVIDE ( CALCULATE ( [Sesi Membeli], Sesi[persentil] <= 5 ), CALCULATE ( [Total Sesi], Sesi[persentil] <= 5 ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 24cfbb79-b9e7-4335-9416-3e9042783209

	measure 'Recall Top 5%' = DIVIDE ( CALCULATE ( [Sesi Membeli], Sesi[persentil] <= 5 ), [Sesi Membeli] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f948646c-032d-4bce-bd1f-ab2a158813fe

	measure 'Lift Top 5%' = DIVIDE ( [Precision Top 5%], [Tingkat Pembelian] )
		formatString: 0.0"x"
		lineageTag: b6691989-e106-4396-8a59-8af25820046c

	measure 'Persen Berkeranjang' = DIVIDE ( CALCULATE ( [Total Sesi], Sesi[n_keranjang] > 0 ), [Total Sesi] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 118fb112-8bd1-4bf0-afb4-0ecdaac520b5

	measure 'Porsi Pembeli' = DIVIDE ( [Sesi Membeli], CALCULATE ( [Sesi Membeli], ALL ( Sesi[Segmen Skor] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 02e018a1-f9d1-400d-98dc-ce86138b11a4

	measure 'Sesi Dinilai (Label)' = FORMAT ( [Total Sesi], "#,0" )
		lineageTag: 888ae33f-6c18-4638-822a-4361944ccda5

	measure 'Total Sesi (Uji)' = CALCULATE ( [Total Sesi], Sesi[periode] = "Uji" )
		formatString: #,0
		lineageTag: ce76da51-f932-4e6b-883d-a0cf45efb033

	measure 'Sesi Membeli (Uji)' = CALCULATE ( [Sesi Membeli], Sesi[periode] = "Uji" )
		formatString: #,0
		lineageTag: 058f1b05-0b62-425d-9bff-682f0417f475

	measure 'Tingkat Pembelian (Uji)' = CALCULATE ( [Tingkat Pembelian], Sesi[periode] = "Uji" )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 55fee260-e23a-4da8-91ed-edd9ec85b4e6

	measure 'Rata-rata Skor (Uji)' = CALCULATE ( [Rata-rata Skor], Sesi[periode] = "Uji" )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7d845d61-ba87-44a9-93bd-3df2062c3a7a

	measure 'Persen Berkeranjang (Uji)' = CALCULATE ( [Persen Berkeranjang], Sesi[periode] = "Uji" )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 67794934-d604-44d7-9494-e24f2c907396

	measure 'Porsi Pembeli (Uji)' = DIVIDE ( [Sesi Membeli (Uji)], CALCULATE ( [Sesi Membeli (Uji)], ALL ( Sesi[Segmen Skor] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c76ddc3f-48a1-4f33-962f-c47ffe60d611

	measure 'Porsi Sesi (Uji)' = DIVIDE ( [Total Sesi (Uji)], CALCULATE ( [Total Sesi (Uji)], ALL ( Sesi[Segmen Skor] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b956a8dc-0181-427f-b068-df29bdced693

	measure 'Precision 5% (Uji)' = CALCULATE ( [Precision Top 5%], Sesi[periode] = "Uji" )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 09970f3a-cf3c-4977-a7aa-b121fee0da7a

	measure 'Recall 5% (Uji)' = CALCULATE ( [Recall Top 5%], Sesi[periode] = "Uji" )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d329fd37-5fa9-4c9f-b02f-a9ca3d0e2e5f

	measure 'Lift 5% (Uji)' = DIVIDE ( [Precision 5% (Uji)], [Tingkat Pembelian (Uji)] )
		formatString: 0.0"x"
		lineageTag: 29bbd79e-04ae-4d6f-9252-acaa045772a7

	measure 'Precision @K' = VAR k = SELECTEDVALUE ( 'Target K'[Target K %] ) RETURN CALCULATE ( DIVIDE ( CALCULATE ( [Sesi Membeli], Sesi[persentil] <= k ), CALCULATE ( [Total Sesi], Sesi[persentil] <= k ) ), Sesi[periode] = "Uji" )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 74952d98-a20b-4550-868e-d42f8a00f31b

	measure 'Recall @K' = VAR k = SELECTEDVALUE ( 'Target K'[Target K %] ) RETURN CALCULATE ( DIVIDE ( CALCULATE ( [Sesi Membeli], Sesi[persentil] <= k ), [Sesi Membeli] ), Sesi[periode] = "Uji" )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 71c321d9-50fa-4abd-8c7e-09a762a8da60

	measure 'Lift @K' = DIVIDE ( [Precision @K], [Tingkat Pembelian (Uji)] )
		formatString: 0.0"x"
		lineageTag: 33c71763-250d-4f84-9ba3-55482eeac45b

	measure 'Tingkat Pembelian 7 Hari' = CALCULATE ( [Tingkat Pembelian], DATESINPERIOD ( Tanggal[Date], MAX ( Tanggal[Date] ), -7, DAY ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 704c1066-59e7-4f54-a1c2-71cbf0d9ec55

	measure 'Porsi Pembeli Rendah (Uji)' = CALCULATE ( [Porsi Pembeli (Uji)], Sesi[Segmen Skor] = "3 Rendah" )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ffcda885-8b56-40d3-91ae-3a90fb13f8dd

