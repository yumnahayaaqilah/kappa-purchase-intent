table Kategori
	lineageTag: 7f04a2db-7239-47aa-9550-34741f336c44

	measure 'Konversi Keranjang' = CALCULATE ( DIVIDE ( SUM ( Kategori[purchases] ), SUM ( Kategori[carts] ) ), KEEPFILTERS ( Kategori[category] <> "unknown" ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4b0e8a6e-5880-4f04-9209-b005d474fb2e

	measure 'Keranjang (Event)' = CALCULATE ( SUM ( Kategori[carts] ), KEEPFILTERS ( Kategori[category] <> "unknown" ) )
		formatString: #,0
		lineageTag: 47a16051-0685-4f94-9d01-82f69bf7d188

	measure 'Pembelian (Event)' = CALCULATE ( SUM ( Kategori[purchases] ), KEEPFILTERS ( Kategori[category] <> "unknown" ) )
		formatString: #,0
		lineageTag: 8decee0e-117b-4cc3-a7f3-b5d6c1e2958d

	measure 'Keranjang Non-elektronik' = CALCULATE ( [Keranjang (Event)], KEEPFILTERS ( Kategori[category] <> "electronics" ) )
		formatString: #,0
		lineageTag: 8807d9a6-a5c5-4250-bfc5-be79fb14ea70

	measure 'Pembelian Non-elektronik' = CALCULATE ( [Pembelian (Event)], KEEPFILTERS ( Kategori[category] <> "electronics" ) )
		formatString: #,0
		lineageTag: f01f1202-cfa2-4bea-bc48-8fd738590bad

	measure 'Keranjang Elektronik' = CALCULATE ( SUM ( Kategori[carts] ), Kategori[category] = "electronics" )
		formatString: #,0
		lineageTag: 27c79fba-176a-452b-92f8-d11d94ebb72c

	measure 'Porsi Keranjang Elektronik' = DIVIDE ( [Keranjang Elektronik], CALCULATE ( SUM ( Kategori[carts] ), ALL ( Kategori ), Kategori[category] <> "unknown" ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 685a0048-94a6-4267-b82f-235e2cf90737

	measure 'Porsi Pembelian Elektronik' = DIVIDE ( CALCULATE ( SUM ( Kategori[purchases] ), Kategori[category] = "electronics" ), CALCULATE ( SUM ( Kategori[purchases] ), ALL ( Kategori ), Kategori[category] <> "unknown" ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6bd51c00-81bb-450e-8066-e00967cb6858

